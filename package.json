{
  "name": "@jobb/jobb",
  "private": true,
  "version": "1.1.3",
  "type": "module",
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=junit.xml test/*.test.mjs && npm run test --workspaces --if-present",
    "dev": "npm run dev --workspace @workoholic/web",
    "postinstall": "node -e \"process.env.WORKERS_CI==='1'&&process.env.WORKERS_CI_BRANCH==='main'&&require('child_process').execFileSync(process.execPath,['tools/setup.mjs','--workers-build'],{stdio:'inherit'})\"",
    "setup:cloudflare": "node --env-file-if-exists=setup.env tools/setup.mjs",
    "secrets:push": "node --env-file-if-exists=setup.env tools/secrets.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "wrangler": "4.161.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "undici@<7.29.1": "8.12.4",
    "sharp@<0.35.5": "0.35.5"
  }
}
