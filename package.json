{
  "name": "@jobb/jobb",
  "private": true,
  "version": "1.1.3",
  "type": "module",
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=junit.xml test/*.test.mjs && npm run test --workspaces --if-present",
    "dev": "npm run dev --workspace @workoholic/web",
    "setup:cloudflare": "node --env-file-if-exists=setup.env tools/setup.mjs",
    "secrets:push": "node --env-file-if-exists=setup.env tools/secrets.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "undici@<7.29.1": "8.12.4",
    "sharp@<0.35.5": "0.35.5"
  }
}
